{
  "manifest_version": 3,
  "name": "AutoCollapse",
  "version": "0.1.0",
  "description": "Automatically collapse inactive tab groups when you switch between them.",
  "permissions": [
    "tabGroups"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AutoCollapse — Tab Group Manager"
  }
}
